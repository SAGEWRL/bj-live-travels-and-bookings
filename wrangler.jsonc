{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "marevia",
  "main": "workers/index.js",
  "compatibility_date": "2026-10-22",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/uploads/properties/*",
      "/admin",
      "/booking",
      "/contact",
      "/gallery",
      "/properties/*"
    ],
    "not_found_handling": "404-page"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "marevia",
      "database_id": "90eeef81-39b0-4dd6-9ab8-220470538a8a"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PROPERTY_PHOTOS",
      "bucket_name": "marevia-property-photos"
    }
  ],
  "vars": {
    "NODE_ENV": "production"
  },
  "secrets": {
    "required": [
      "ADMIN_PASSWORD",
      "BOOKING_ACCESS_SECRET"
    ]
  }
}